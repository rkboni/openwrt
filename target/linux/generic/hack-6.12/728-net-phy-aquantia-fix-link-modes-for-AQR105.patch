+/*
+ * The AQR105 is used by default as a generic 10G C45 PHY. When the
+ * "marvell,fixed-system-interface" DT property is present the PHY's
+ * MAC-side interface is hard-wired (e.g. behind a switch port) and the
+ * PHY must behave like an aqr107-family 2.5G PHY: load firmware, enforce
+ * the interface whitelist, advertise only the link modes the fixed
+ * interface can carry and keep phydev->interface pinned to the DT value.
+ * Without the property the upstream behavior (10GBASE-T included) is kept.
+ */
+static int aqr105_probe(struct phy_device *phydev)
+{
+	if (!of_property_read_bool(phydev->mdio.dev.of_node,
+				   "marvell,fixed-system-interface"))
+		return 0;
+
+	return aqr107_probe(phydev);
+}
+
+static int aqr105_config_init(struct phy_device *phydev)
+{
+	if (!of_property_read_bool(phydev->mdio.dev.of_node,
+				   "marvell,fixed-system-interface"))
+		return 0;
+
+	return aqr107_config_init(phydev);
+}
+
+static int aqr105_read_status(struct phy_device *phydev)
+{
+	if (!of_property_read_bool(phydev->mdio.dev.of_node,
+				   "marvell,fixed-system-interface"))
+		return aqr_read_status(phydev);
+
+	return aqr107_read_status(phydev);
+}
+
+static int aqr105_get_features(struct phy_device *phydev)
+{
+	if (!of_property_read_bool(phydev->mdio.dev.of_node,
+				   "marvell,fixed-system-interface"))
+		return genphy_c45_pma_read_abilities(phydev);
+
+	return aqr111_get_features(phydev);
+}
 
